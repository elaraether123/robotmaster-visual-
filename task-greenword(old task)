import cv2
import numpy as np

img = np.zeros((500, 800, 3), dtype=np.uint8)

text = "Hello, OpenCV!"
font = cv2.FONT_HERSHEY_SIMPLEX
position = (100, 250) 
font_scale = 2
color = (0, 255, 0)  
thickness = 3

cv2.putText(img, text, position, font, font_scale, color, thickness)

cv2.imshow("Black Background + Green Text", img)
cv2.waitKey(0)
cv2.destroyAllWindows()
